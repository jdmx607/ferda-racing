rules_version = '2';

// FERDA Racing League — Firestore Security Rules
//
// Architecture: one document per season at leagues/ferda-season-YYYY.
// The ACTIVE season's document is the live league; every earlier season is an
// archive (flagged `archived: true` by the rollover) and becomes READ-ONLY.
// No Firebase Auth is used; the app does client-side password auth.
//
// Goals:
//   1. Block ALL paths except the season documents the app actually uses.
//   2. Allow reads freely (it's a fantasy league for 4 friends, not sensitive).
//   3. Validate writes have the expected top-level structure — prevents
//      accidental overwrites with empty/malformed documents.
//   4. Never expires (replaces the test-mode rules that expire after 30 days).
//   5. Keep archived seasons exactly as they were — no client can edit them.
//
// To deploy:
//   firebase deploy --only firestore:rules
//   (requires firebase-tools: npm install -g firebase-tools && firebase login)
//
// To correct something in an archived season (rare): in the Firebase console set
// that document's `archived` field to false, make the fix, then set it back to true.

service cloud.firestore {
  match /databases/{database}/documents {

    // Only documents named ferda-season-20XX can be read or written.
    function isSeasonDoc(id) {
      return id.matches('ferda-season-20[0-9][0-9]');
    }

    // Writes must carry the expected top-level fields.
    function hasLeagueShape() {
      return request.resource.data.keys().hasAll(['results', 'picks', 'meta'])
          && request.resource.data.meta is map
          && request.resource.data.results is map;
    }

    // A season document already flagged archived is frozen.
    function isArchived() {
      return resource != null && resource.data.get('archived', false) == true;
    }

    match /leagues/{seasonId} {
      allow read: if isSeasonDoc(seasonId);
      allow create, update: if isSeasonDoc(seasonId) && hasLeagueShape() && !isArchived();
      // no client deletes — a season is never removed
    }

    // Everything else is locked — no other collection or document can be read
    // or written by any client.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
